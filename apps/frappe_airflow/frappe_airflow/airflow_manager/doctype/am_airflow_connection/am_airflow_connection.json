{
  "name": "AM Airflow Connection",
  "doctype": "DocType",
  "module": "Airflow Manager",
  "is_virtual": 1,
  "autoname": "field:conn_id",
  "title_field": "conn_id",
  "fields": [
    {"fieldname": "marketplace_section", "fieldtype": "Section Break", "label": "Marketplace"},
    {"fieldname": "platform", "fieldtype": "Select", "label": "Marketplace",
     "options": "wb\noz\nms\nym", "reqd": 1, "in_list_view": 1},
    {"fieldname": "slug", "fieldtype": "Data", "label": "Slug", "reqd": 1, "in_list_view": 1},
    {"fieldname": "display_name", "fieldtype": "Data", "label": "Display Name", "in_list_view": 1},
    {"fieldname": "conn_id", "fieldtype": "Data", "label": "Connection ID", "reqd": 1, "read_only": 1, "in_list_view": 1},
    {"fieldname": "conn_type", "fieldtype": "Select", "label": "Type",
     "options": "wb\noz_seller\noz_perf\nms\nother", "reqd": 1, "in_list_view": 1},
    {"fieldname": "description", "fieldtype": "Small Text", "label": "Description"},
    {"fieldname": "credentials_section", "fieldtype": "Section Break", "label": "Credentials"},
    {"fieldname": "api_token", "fieldtype": "Password", "label": "API Token", "length": 2048,
     "depends_on": "eval:['wb','oz_seller'].includes(doc.conn_type)"},
    {"fieldname": "client_seller_id", "fieldtype": "Data", "label": "Client Seller ID",
     "depends_on": "eval:doc.conn_type=='oz_seller'"},
    {"fieldname": "perf_id", "fieldtype": "Data", "label": "Performance Client ID",
     "depends_on": "eval:doc.conn_type=='oz_perf'"},
    {"fieldname": "perf_secret", "fieldtype": "Password", "label": "Performance Secret", "length": 2048,
     "depends_on": "eval:doc.conn_type=='oz_perf'"},
    {"fieldname": "ms_token", "fieldtype": "Password", "label": "MoySklad Token", "length": 2048,
     "depends_on": "eval:doc.conn_type=='ms'"}
  ],
  "permissions": [{"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1}]
}
