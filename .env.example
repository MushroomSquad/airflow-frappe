# MariaDB (Frappe's own database)
MARIADB_ROOT_PASSWORD=change_me
DB_NAME=airflow_manager
DB_USER=frappe
DB_PASSWORD=change_me

# Frappe
FRAPPE_SITE_NAME=airflow-manager.localhost
ADMIN_PASSWORD=change_me
FRAPPE_PORT=8000

# Airflow integration — REQUIRED
# AIRFLOW_DB_URL: restricted user with SELECT/INSERT/UPDATE/DELETE on connection+variable, SELECT on dag
AIRFLOW_DB_URL=postgresql+psycopg2://airflow_ui:change_me@airflow-postgres:5432/airflow
# AIRFLOW_FERNET_KEY: copy exactly from AIRFLOW__CORE__FERNET_KEY in your Airflow deployment
AIRFLOW_FERNET_KEY=
